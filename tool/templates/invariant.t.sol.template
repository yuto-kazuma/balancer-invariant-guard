pragma solidity ^0.8.19;

// Auto-generated by InvariantBreaker
// Template: per-transaction BPT rate stability invariant
//
// Usage: copy into test/ and customize pool interface

import {Test} from "forge-std/Test.sol";

interface IPool {
    function getRate() external view returns (uint256);
    function batchSwap(bytes calldata data) external;
}

abstract contract InvariantBreakerTemplate is Test {
    IPool pool;

    uint256 constant MAX_RATE_CHANGE_BPS = 100; // 1%

    /// @notice Enforces: BPT rate must not change >1% within a single transaction
    /// @dev Would have caught Balancer V2 Nov 2025 exploit (20x rate change)
    function _assertBptRateStable(uint256 rateBefore, uint256 rateAfter) internal pure {
        if (rateBefore == 0) return;

        uint256 changeBps;
        if (rateAfter > rateBefore) {
            changeBps = ((rateAfter - rateBefore) * 10000) / rateBefore;
        } else {
            changeBps = ((rateBefore - rateAfter) * 10000) / rateBefore;
        }

        assertLe(
            changeBps,
            MAX_RATE_CHANGE_BPS,
            "InvariantBreaker: BPT rate changed beyond 1% in single tx"
        );
    }

    /// @notice Enforces: rounding must favor protocol on upscale
    /// @dev Flag if _upscale uses mulDown on GIVEN_OUT paths
    function _assertProtocolFavoringUpscale(
        uint256 amount,
        uint256 rate,
        uint256 upscaledDown,
        uint256 upscaledUp
    ) internal pure {
        assertGe(upscaledUp, upscaledDown, "mulUp must >= mulDown for same inputs");
        // On GIVEN_OUT: use upscaledUp (round up) to protect pool
        assertGe(upscaledUp, (amount * rate) / 1e18 - 1, "Upscale must not under-estimate");
    }
}
